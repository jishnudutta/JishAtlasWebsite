# docker compose reads this file automatically (copy to .env to use it).
#
# Host port the JishAtlas website is exposed on. The container's nginx listens
# on port 80 internally; this value is the port on the VPS itself.
#
#   - Default 3002: jishatlas.jishworks.in is forwarded to VPS:3002.
#   - Override with PORT=… only if you need a different host port.
PORT=3002
